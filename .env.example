NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only RICO Europe Dropshipper API v2 configuration.
RICO_RELAY_API_KEY=enter-rotated-rico-api-key-in-deployment-environment
RICO_API_BASE_URL=https://ricoeurope.com/reseller-api

# Server-only RICO Europe Fleet API configuration. This is a separate account and key.
RICO_FLEET_API_KEY=enter-rico-fleet-api-key-in-deployment-environment
RICO_FLEET_API_BASE_URL=https://app.ricoeurope.com/api/customer

# Server-only bearer tokens for RICO to read RELAY's serialized fleet feed.
RICO_FLEET_FEED_TOKEN=generate-a-long-random-partner-token
RICO_FLEET_FEED_TOKEN_PREVIOUS=optional-previous-token-during-rotation

# Server-only JCB LiveLink. Apply the LiveLink migration before enabling.
JCB_LIVELINK_ENABLED=false
JCB_LIVELINK_USERNAME=
JCB_LIVELINK_PASSWORD=
JCB_LIVELINK_CLIENT_SECRET=

# Fleet health monitoring: keep disabled until migration and scheduled-job setup are verified.
JCB_HEALTH_ALERTS_ENABLED=false
CRON_SECRET=
# Local development preview only; never enables live alerts.
RELAY_HEALTH_PREVIEW=false

# Server-only Supabase key used only by the JCB health scheduler.
JCB_HEALTH_DATABASE_KEY=

# Manitou Trackunit Classic API, server-only. Shared internal fitter grants.
TRACKUNIT_ENABLED=false
TRACKUNIT_API_KEY=
TRACKUNIT_HEALTH_ALERTS_ENABLED=false
# Manitou scheduler uses the existing JCB_HEALTH_DATABASE_KEY and CRON_SECRET.
