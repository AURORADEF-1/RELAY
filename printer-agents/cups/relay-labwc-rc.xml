<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
  </core>
  <windowRules>
    <windowRule title="RELAY Wallboard*">
      <!-- The display launcher places the portrait DSI screen to the left of HDMI. -->
      <action name="MoveToOutput" direction="right" wrap="no" />
      <action name="ToggleFullscreen" />
    </windowRule>
    <windowRule title="RELAY Front Counter Terminal*">
      <action name="MoveToOutput" direction="left" wrap="no" />
      <action name="ToggleFullscreen" />
    </windowRule>
  </windowRules>
</labwc_config>
