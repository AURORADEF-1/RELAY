#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
node scripts/verify-secret-files.mjs
scanner="${GITLEAKS_BIN:-.tools/gitleaks}"
if [ ! -x "$scanner" ]; then scanner=gitleaks; fi
if ! command -v "$scanner" >/dev/null 2>&1; then
  echo "Commit blocked: install Gitleaks before committing. See docs/security/credentials.md." >&2
  exit 1
fi
"$scanner" git --staged --redact=100 --ignore-gitleaks-allow --no-banner --config .gitleaks.toml
